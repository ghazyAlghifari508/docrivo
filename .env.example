# Database. Two connections: the app and the test suite.
# DATABASE_URL must never resolve to the test database -- the schemas are
# identical, so a test-first resolution is invisible until someone truncates a
# table they did not mean to.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docrivo
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/docrivo_test

# Auth. Better Auth signs the session cookie with BETTER_AUTH_SECRET; the three
# Google values are the OAuth client's. All four are server-only -- there is no
# NEXT_PUBLIC_* convention in this project, and nothing here belongs in the
# browser bundle.
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public origin. Used to build the OAuth callback and the Midtrans redirect, so
# it has to match what the browser actually opened.
APP_URL=http://localhost:3000

# Comma-separated allowlist for /admin. An address that is not on it, and a
# signed-out visitor, both get the same not-found answer.
ADMIN_EMAILS=you@example.com

# Screenshots the worker captures. Relative paths resolve against the process's
# working directory, which differs between the dev server, the built bundle and
# vitest -- so prefer an absolute path outside development.
SCREENSHOT_DIR=var/screenshots

# Worker poll interval, and the process's own health port.
WORKER_POLL_MS=2000
PORT=8080

# AI provider: NVIDIA NIM, OpenAI-compatible. The base URL is compiled in
# src/lib/ai-provider.ts; only the key and the model are configurable. AI_MODEL
# overrides the default model and is tried after it.
NVIDIA_API_KEY=nvapi-xxx
AI_MODEL=ag/gemini-3.8-flash-high

# Midtrans Snap. The server key is server-only. MIDTRANS_PRODUCTION=true
# switches both endpoints from sandbox to live; the default is sandbox.
MIDTRANS_SERVER_KEY=Mid-server-xxxx
MIDTRANS_PRODUCTION=false

# Per-job crawl cap, used when seeding a job by hand. The queue stores it in
# generation_jobs.max_pages, which is what the worker actually reads.
MAX_PAGES=5
